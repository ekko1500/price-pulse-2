# Copy this file to `.env` and fill in real values.

# 1) Create a bot with @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 2) Base URL of the running PricePulse web app (Next.js).
#    Local dev:  http://localhost:3000
#    Deployed:   https://your-cloud-run-service-url
PRICEPULSE_API_URL=http://localhost:3000

# Optional
# Default language for new chats: en | my
DEFAULT_LANG=en
# Per-request timeout (ms) when calling the web API.
REQUEST_TIMEOUT_MS=20000
