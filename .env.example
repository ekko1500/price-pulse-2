# ---------------------------------------------------------------------------
# PricePulse Myanmar - environment configuration TEMPLATE
# Copy this file to `.env.local` and fill in your own values.
# NEVER put real secrets in this file: it is committed to the repository.
# ---------------------------------------------------------------------------

# Reserved for future signed-cookie mode. Sessions currently use opaque,
# server-stored random tokens (no client-trusted claims), so this is OPTIONAL.
PRICEPULSE_SESSION_SECRET=

# Google Gemini API key for server-side price extraction.
# If omitted, the app uses a strict, validated deterministic parser (no fabrication).
GEMINI_API_KEY=

# Optional model override (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Firebase / Firestore (optional). Leave blank to use the built-in persistent
# server JSON store. When configured, the store switches to Cloud Firestore
# automatically (see lib/db/firestore.ts and lib/db/store.ts).
#
# On Firebase App Hosting or Cloud Run, Application Default Credentials are used
# automatically - do NOT set the service-account keys below there.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the private key on ONE line with literal \n escapes, wrapped in quotes.
FIREBASE_PRIVATE_KEY=
# Force Application Default Credentials on a non-GCP host (e.g. a custom runner).
PRICEPULSE_USE_ADC=
# Optional backend override: `file` or `firestore`. Default is auto-detect
# (firestore when credentials are present, otherwise the local file store).
PRICEPULSE_BACKEND=
# Optional: point at the Firestore emulator for local testing.
FIRESTORE_EMULATOR_HOST=

# Client-side Firebase config (reserved; the server uses the Admin SDK).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
