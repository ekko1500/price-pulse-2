# ---------------------------------------------------------------------------
# PricePulse Myanmar - environment configuration TEMPLATE
# Copy this file to `.env.local` and fill in your own values.
# NEVER put real secrets in this file: it is committed to the repository.
# ---------------------------------------------------------------------------

# Reserved for future signed-cookie mode. Sessions currently use opaque,
# server-stored random tokens (no client-trusted claims), so this is OPTIONAL.
PRICEPULSE_SESSION_SECRET=

# Where the file store writes (only used when Firebase is NOT configured).
# Point this at a persistent volume on a container host.
PRICEPULSE_DATA_DIR=

# ---------------------------------------------------------------------------
# Google Gemini API key for server-side price extraction (server-only secret).
# Create one at https://aistudio.google.com/apikey — free tier, no card.
# If omitted, the app uses a strict, validated deterministic parser.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional default model. The retiree gemini-1.5-flash is DEAD — use a current
# model. Users can also pick a model in the UI (see lib/ai/models.ts).
#   gemini-2.5-flash-lite   (free, default)
#   gemini-2.5-flash        (free)
#   gemini-3.5-flash / gemini-3.6-flash
#   gemini-2.5-pro          (paid)
GEMINI_MODEL=gemini-2.5-flash-lite

# Model used for thumbnail image moderation + tagging (defaults to GEMINI_MODEL).
GEMINI_VISION_MODEL=

# Thumbnail moderation policy when Gemini is unavailable: "lenient" (default,
# accept as unchecked — offline-friendly) or "strict" (reject unmoderated).
THUMBNAIL_MODERATION=lenient

# ---------------------------------------------------------------------------
# Firebase / Firestore (optional). When the three admin vars below are set the
# persistence layer uses Cloud Firestore (multi-instance safe). Leave blank to
# use the built-in single-process JSON file store.
#   Firebase console > Project settings > Service accounts > Generate key.
# Keep FIREBASE_PRIVATE_KEY on ONE line with literal \n escapes, quoted.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Firebase Storage for centralised reference thumbnails. Uses the same service
# account as Firestore. Defaults to <project>.appspot.com when omitted. When
# Firebase is not configured, thumbnails are stored inline (local dev only).
# ---------------------------------------------------------------------------
FIREBASE_STORAGE_BUCKET=

# ---------------------------------------------------------------------------
# Firebase web SDK config (REQUIRED for direct browser uploads to Storage).
# Find these in Firebase console > Project settings > Your apps > Web app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
